{
  "name": "@nullframe/sdk",
  "version": "0.1.0",
  "description": "Thin client for the NullFrame local REST API",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mts",
    "build": "tsrs",
    "typecheck": "tsrs --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nullframe",
    "browser-automation",
    "anti-detect",
    "cdp"
  ],
  "homepage": "https://nullframe.app",
  "author": "omninoy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omninoy/nullframe.git",
    "directory": "sdk/node"
  },
  "devDependencies": {
    "tsrs": "^0.22.0-ts7.1.0-beta"
  }
}
